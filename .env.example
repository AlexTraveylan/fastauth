FASTAUTH_POSTGRES_POOLER_CONNECTION_STRING=postgresql+asyncpg://postgres:fastauth@localhost:5432/fastauth
JWT_SECRET_KEY=change-me

# --- Rate limiting, par IP ---
# Format : "<n>/<second|minute|hour|day>", plusieurs règles séparées par ";" (toutes doivent passer).
# Volontairement larges : plusieurs joueurs (une classe, un foyer) peuvent partager la même IP (NAT).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute;100/hour
RATE_LIMIT_REGISTER=5/minute;30/hour
RATE_LIMIT_REFRESH=30/minute;300/hour
RATE_LIMIT_GOOGLE=20/minute;200/hour
# memory:// = compteurs par process (remis à zéro au redémarrage). Plusieurs instances : un backend partagé
# type redis://host:6379 (nécessite le paquet python `redis`).
RATE_LIMIT_STORAGE_URI=memory://
# Derrière un reverse proxy : sans ça, tous les utilisateurs partagent l'IP du proxy et se bloquent entre eux.
# À restreindre aux IP du proxy si possible.
FORWARDED_ALLOW_IPS=*
