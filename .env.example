# Chaîne de connexion Postgres. En local, fournie par docker compose.
FASTAUTH_POSTGRES_POOLER_CONNECTION_STRING=postgresql://user:password@host:5432/dbname
# SSL: true en prod, false en local.
DB_SSL=true
# Secret JWT — valeur forte en prod.
JWT_SECRET_KEY=change-me
# Origines CORS autorisées (séparées par des virgules).
ALLOWED_ORIGINS=http://localhost:3000
# URL du front (redirections OAuth).
FRONTEND_URL=http://localhost:3000
# OAuth Google (optionnel en local)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
